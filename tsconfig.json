{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "module": "CommonJS",
    "noImplicitAny": true,
    "lib": ["es2018", "dom", "dom.iterable"],
    "outDir": "dist",
    "target": "es2015",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "typedocOptions": {
    "mode": "modules",
    "out": "docs"
  },
  "include": ["src/**/*"],
  // The build feeds `files: ["/dist"]`, so anything emitted here ships to
  // every consumer. Tests were emitted alongside the library and made up
  // more than half the published tarball. They are still type-checked —
  // `npm run typecheck` compiles them via `tsconfig.typecheck.json`.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
